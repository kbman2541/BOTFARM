-- Version : 1.7 (Final) + Auto Hop (Money Stagnant + Match + Auto Retry) - No External Log --
repeat
    task.wait()
until game:IsLoaded()
task.wait(10)
local DelaySend = 10

local Players = game:GetService("Players")
local Client = Players.LocalPlayer
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")

local _request = http_request or request or syn.request or xeno.request

local stagnantTime = 0
local matchTime = 0
local last_All_Money = -1
local isHopping = false -- ป้องกันสคริปต์ทำงานซ้อนกันตอนกำลังวาร์ป

-- สร้าง Blacklist สำหรับเก็บ JobID ที่เข้าไม่ได้ จะได้ไม่หาซ้ำ
getgenv().AKB_FailedServers = getgenv().AKB_FailedServers or {}
getgenv().AKB_FailedServers[game.JobId] = true

local function FormatNumber(n)
    local formatted = tostring(n)
    local k
    while true do
        formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
        if k == 0 then break end
    end
    return formatted
end

local function GetMoney(_type)
    local gui = Client.PlayerGui
    local keyword = _type == "bank" and "bank balance" or "hand balance"
    if gui then
        for _, v in gui:GetDescendants() do
            if v:IsA("TextLabel") and v.Text:lower():find(keyword:lower()) then
                local rawText = v.Text
                local numberText = rawText:gsub("[^%d]", "")
                return tonumber(numberText) or 0
            end
        end
    end
    return 0
end

-- ลบการส่ง API ไปภายนอกออก เหลือแค่ Print แจ้งเตือนใน Console
local function SendLog(description)
    print(description)
end

-- ระบบย้ายเซิฟและวนซ้ำ (Auto Retry ทะลุ Error 769 และห้องเต็ม)
local function HopToLowPlayerServer()
    if not _request then warn("❌ Executor ไม่รองรับ HTTP Request") return end
    
    print("⏳ กำลังค้นหาเซิร์ฟเวอร์คนน้อย...")
    task.spawn(function()
        local placeId = game.PlaceId
        local cursor, searchedPages, maxPages = "", 0, 10
        local candidates = {}
        local backup_candidates = {} -- สำรองเผื่อไม่มีห้องคนน้อยกว่า 5
        
        while searchedPages < maxPages do
            searchedPages = searchedPages + 1
            local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
            if cursor and cursor ~= "" then url = url .. "&cursor=" .. cursor end
            
            local success, response = pcall(function() return _request({Url = url, Method = "GET"}) end)
            if success and response and response.Body then
                local body = HttpService:JSONDecode(response.Body)
                if body and body.data then
                    for _, v in ipairs(body.data) do
                        if type(v) == "table" and v.id and not getgenv().AKB_FailedServers[v.id] then
                            local playing = v.playing or 0
                            local ping = v.ping or 999
                            
                            if playing > 0 and ping <= 180 then
                                if playing <= 4 then
                                    table.insert(candidates, {id = v.id, ping = ping, players = playing})
                                end
                                -- เก็บสำรองไว้เสมอ เผื่อไม่มีห้องคนน้อยจริงๆ
                                table.insert(backup_candidates, {id = v.id, ping = ping, players = playing})
                            end
                        end
                    end
                    if #candidates >= 10 then break end -- ได้เป้าหมายพอแล้วหยุดหาทันที
                    if body.nextPageCursor then
                        cursor = body.nextPageCursor
                    else break end
                end
            else 
                warn("❌ ดึงข้อมูลเซิร์ฟเวอร์ล้มเหลว")
                break 
            end
        end
        
        -- แก้ปัญหาห้องไม่มีคนน้อยกว่า 5 โดยใช้รายชื่อสำรอง
        if #candidates == 0 and #backup_candidates > 0 then
            candidates = backup_candidates
        end
        
        if #candidates > 0 then
            -- เรียงจากคนน้อยที่สุดและปิงต่ำสุด
            table.sort(candidates, function(a, b) 
                if a.players == b.players then return a.ping < b.ping end
                return a.players < b.players
            end)
            
            if #candidates > 5 then
                local topCandidates = {}
                for i = 1, 5 do table.insert(topCandidates, candidates[i]) end
                candidates = topCandidates
            end
            
            for i = #candidates, 2, -1 do
                local j = math.random(1, i)
                candidates[i], candidates[j] = candidates[j], candidates[i]
            end
            
            local currentAttempt = 1
            if getgenv().AKB_TPConnection then getgenv().AKB_TPConnection:Disconnect() end
            
            local function attemptTeleport()
                if currentAttempt > #candidates then
                    print("❌ ห้องที่เจอเข้าไม่ได้เลย จะทำการสแกนหาหน้าเว็บใหม่...")
                    if getgenv().AKB_TPConnection then getgenv().AKB_TPConnection:Disconnect(); getgenv().AKB_TPConnection = nil end
                    task.wait(2)
                    HopToLowPlayerServer() -- วนหารอบใหม่จนกว่าจะได้
                    return
                end
                
                local targetServer = candidates[currentAttempt]
                print("🚀 กำลังพยายามวาร์ปไปห้อง " .. targetServer.players .. " คน (ปิง: "..targetServer.ping..")")
                
                -- กัน Error ค้างตอน Teleport
                local s, e = pcall(function()
                    TeleportService:TeleportToPlaceInstance(placeId, targetServer.id, Client)
                end)
                if not s then
                    print("⚠️ วาร์ปบั๊ก ข้ามไปห้องต่อไป...")
                    currentAttempt = currentAttempt + 1
                    task.wait(1.5)
                    attemptTeleport()
                end
            end
            
            getgenv().AKB_TPConnection = TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
                if player == Client then
                    if candidates[currentAttempt] then 
                        getgenv().AKB_FailedServers[candidates[currentAttempt].id] = true 
                    end
                    print("⚠️ วาร์ปล้มเหลว (Error) ลองห้องถัดไป...")
                    currentAttempt = currentAttempt + 1
                    task.wait(2)
                    attemptTeleport()
                end
            end)
            
            task.delay(45, function() 
                if getgenv().AKB_TPConnection then getgenv().AKB_TPConnection:Disconnect(); getgenv().AKB_TPConnection = nil end 
            end)
            
            attemptTeleport()
        else
            print("❌ ไม่พบห้องที่เหมาะสมเลย จะหาใหม่ใน 5 วินาที...")
            task.wait(5)
            HopToLowPlayerServer()
        end
    end)
end

_G.CoreSendLog = true
task.spawn(function()
    while _G.CoreSendLog do task.wait()
        if isHopping then
            task.wait(1)
            continue
        end

        local Money_hand = tonumber(GetMoney("hand")) or 0
        local Money_bank = tonumber(GetMoney("bank")) or 0
        local All_Money = Money_hand + Money_bank

        if last_All_Money == -1 then
            last_All_Money = All_Money
        end

        SendLog(string.format("💸 Total: %s | 💵 Hand: %s | 🏦 Bank: %s",
            FormatNumber(All_Money),
            FormatNumber(Money_hand), 
            FormatNumber(Money_bank)
        ))
        
        -- เงื่อนไขที่ 1: เงินตรงตามเป้าเป๊ะ 
        local isMatchTarget = (All_Money == 2000 and Money_hand == 1000 and Money_bank == 1000)
        -- เงื่อนไขที่ 2: เงินค้าง ไม่ขึ้นไม่ลง
        local isStagnant = (All_Money == last_All_Money)

        -- เช็คเงื่อนไขที่ 1
        if isMatchTarget then
            matchTime = matchTime + DelaySend
            print("⚠️ [เงื่อนไขเป้าหมาย] ยอดเงินตรง (" .. matchTime .. "/60 วิ)")
        else
            matchTime = 0
        end

        -- เช็คเงื่อนไขที่ 2
        if isStagnant then
            stagnantTime = stagnantTime + DelaySend
            print("⚠️ [เงินค้าง] ยอดไม่มีการเปลี่ยนแปลง (" .. stagnantTime .. "/60 วิ)")
        else
            last_All_Money = All_Money
            stagnantTime = 0
        end

        -- ถ้าระบบจับได้ว่าอันใดอันหนึ่งถึง 1 นาที ก็จะย้ายทันที
        if matchTime >= 60 or stagnantTime >= 60 then
            isHopping = true
            SendLog("🔄 เงื่อนไขครบ 1 นาที! เริ่มทำการย้ายเซิร์ฟเวอร์...")
            HopToLowPlayerServer()
            matchTime = 0
            stagnantTime = 0 
        end
        
        task.wait(DelaySend or 10)
    end
end)
